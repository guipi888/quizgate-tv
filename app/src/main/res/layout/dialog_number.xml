<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/card"
    android:gravity="center_horizontal"
    android:minWidth="480dp"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_num_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_num_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="72dp"
        android:gravity="center"
        android:text="—"
        android:textColor="@color/accent"
        android:textSize="52sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_num_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3">

        <Button
            android:id="@+id/btn_n1"
            style="@style/PinKey"
            android:text="1" />

        <Button
            android:id="@+id/btn_n2"
            style="@style/PinKey"
            android:text="2" />

        <Button
            android:id="@+id/btn_n3"
            style="@style/PinKey"
            android:text="3" />

        <Button
            android:id="@+id/btn_n4"
            style="@style/PinKey"
            android:text="4" />

        <Button
            android:id="@+id/btn_n5"
            style="@style/PinKey"
            android:text="5" />

        <Button
            android:id="@+id/btn_n6"
            style="@style/PinKey"
            android:text="6" />

        <Button
            android:id="@+id/btn_n7"
            style="@style/PinKey"
            android:text="7" />

        <Button
            android:id="@+id/btn_n8"
            style="@style/PinKey"
            android:text="8" />

        <Button
            android:id="@+id/btn_n9"
            style="@style/PinKey"
            android:text="9" />

        <Button
            android:id="@+id/btn_ndel"
            style="@style/PinKey"
            android:text="删除" />

        <Button
            android:id="@+id/btn_n0"
            style="@style/PinKey"
            android:text="0" />

        <Button
            android:id="@+id/btn_nok"
            style="@style/PinKey"
            android:text="确认" />
    </GridLayout>
</LinearLayout>
